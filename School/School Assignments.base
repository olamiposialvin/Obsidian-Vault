views:
  - type: cards
    name: View
    filters:
      and:
        - Purpose == "Assignment"
        - file.inFolder("School/Assignments")
    groupBy:
      property: Subject
      direction: ASC
    order:
      - file.name
      - Date
    sort:
      - property: Date
        direction: ASC
    columnSize: {}
    columnWidth: 280
    imageAspectRatio: 0.5
    cardSize: 200
